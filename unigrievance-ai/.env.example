# Get a FREE key (no credit card required) at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Model used for triage (categorization, translation, duplicate detection).
# gemini-2.5-flash-lite = highest free-tier daily quota, still solid quality
# gemini-2.5-flash      = default here, better reasoning, slightly lower daily quota
MODEL=gemini-2.5-flash

# Port the server listens on
PORT=3000
